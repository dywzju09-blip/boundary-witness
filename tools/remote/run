#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C

remote_host="server-b"
remote_root="/mnt/hw/bw-agent"
remote_worktree="${remote_root}/worktree"
safety_marker="${remote_root}/.agent-build-root"

# 编译缓存放本地盘，不放 /mnt/hw。/mnt/hw 是 NFS：实测创建 2000 个小文件 19.1s、
# 删除 12.6s，本地盘同样操作 0.16s / 0.09s，差两个数量级。cargo 的 target 目录和
# 构建期临时目录正是密集创建/删除小文件的形态，放 NFS 上纯属自找慢。
#
# 这里只放**可重建的缓存**：target 目录和 TMPDIR。语料、结果、日志、worktree
# 仍然全部留在 /mnt/hw/bw-agent —— 任务数据和产物一个字节都不落到本地盘。
# 缓存整个删掉只会导致下次重编，不会丢任何东西。
local_cache_root="/var/lib/bw-agent"
local_cache_marker="${local_cache_root}/.agent-cache-root"
# 本地盘容量远小于 NFS，跑飞的构建能把 / 写满并拖垮整台机器。低于这个水位直接拒绝开工。
local_cache_min_free_mib=20480

# target 缓存按工具链分开。仓库根用 1.97.0，compiler/bw-rustc 用 nightly-2026-07-08；
# 两者共用一个 target 目录会互相 invalidate，每次切换都全量重编，而且不报错。
declare -A cache_dirs=(
  [workspace]="targets/workspace"
  [bw-rustc]="targets/bw-rustc"
)
cache_name="workspace"
ssh_options=(
  -o BatchMode=yes
  -o ConnectTimeout=10
  -o ServerAliveInterval=15
  -o ServerAliveCountMax=3
)

usage() {
  cat >&2 <<'EOF'
usage: tools/remote/run [--cache <name>] -- <command> [args...]

Synchronize the current working tree, including uncommitted changes, to the
verified server-b workspace and execute the command there. Heavy work never
falls back to the local machine.

options:
  --cache <name>   Which target cache to bind CARGO_TARGET_DIR to.
                   workspace  (default) for the repository-root workspace
                   bw-rustc             for compiler/bw-rustc

Each toolchain needs its own target cache. The repository root builds with
1.97.0 and compiler/bw-rustc builds with nightly-2026-07-08; sharing one cache
makes them invalidate each other and silently rebuild everything every switch.
EOF
}

fail() {
  printf 'remote-run: %s\n' "$*" >&2
  exit 1
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

while [[ "${1:-}" == --* && "${1:-}" != "--" ]]; do
  case "$1" in
    --cache)
      [[ $# -ge 2 ]] || fail "--cache requires a value"
      cache_name="$2"
      shift 2
      ;;
    --cache=*)
      cache_name="${1#--cache=}"
      shift
      ;;
    *)
      usage
      exit 2
      ;;
  esac
done

# 白名单校验：拼错的名字必须当场失败。放任它拼出一个新目录，等于在远端
# 静默造了个一次性工作区，既违反"不要临时工作区"，又让人以为缓存命中了。
[[ -n "${cache_dirs[$cache_name]:-}" ]] ||
  fail "unknown --cache ${cache_name}; expected one of: ${!cache_dirs[*]}"
cache_relative="${cache_dirs[$cache_name]}"

if [[ "${1:-}" != "--" ]]; then
  usage
  exit 2
fi
shift

if [[ $# -eq 0 ]]; then
  usage
  exit 2
fi

command -v ssh >/dev/null 2>&1 || fail "ssh is required"
command -v rsync >/dev/null 2>&1 || fail "rsync is required"
command -v git >/dev/null 2>&1 || fail "git is required"
command -v timeout >/dev/null 2>&1 || fail "timeout is required"

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="$(git -C "${script_dir}/../.." rev-parse --show-toplevel 2>/dev/null)" ||
  fail "tools/remote/run must be used from a Git working tree"
repo_root="$(cd "$repo_root" && pwd -P)"

ignore_file="$(mktemp -t bw-remote-ignore.XXXXXX)"
cleanup() {
  rm -f "$ignore_file"
}
trap cleanup EXIT
git -C "$repo_root" ls-files -z --others --ignored --exclude-standard --directory \
  >"$ignore_file"

if ! timeout --foreground 20s ssh "${ssh_options[@]}" "$remote_host" test -f "$safety_marker"; then
  fail "remote safety marker is missing or unreachable: ${remote_host}:${safety_marker}"
fi

printf 'remote-run: syncing %s to %s:%s\n' \
  "$repo_root" "$remote_host" "$remote_worktree" >&2
rsync \
  --archive \
  --compress \
  --delete-delay \
  --delete-excluded \
  --from0 \
  --partial \
  --safe-links \
  --protect-args \
  --timeout=60 \
  --rsh='ssh -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=3' \
  --exclude-from="$ignore_file" \
  --exclude=target/ \
  --exclude=.worktrees/ \
  --exclude=worktrees/ \
  -- \
  "${repo_root}/" \
  "${remote_host}:${remote_worktree}/"

# 组装远端引导脚本。必须以 `exec` 结尾且不带换行：下面的循环把命令实参逐个
# 追加到这个字符串后面。
remote_script="set -euo pipefail"
remote_script+="; mkdir -p ${local_cache_root}/${cache_relative} ${local_cache_root}/tmp"
# 标记文件让这个目录一眼可辨认是可重建缓存，删掉它只会导致重编。
remote_script+="; [ -f ${local_cache_marker} ] || printf '%s\\n'"
remote_script+=" 'bw-agent rebuildable build cache; safe to delete' >${local_cache_marker}"
# 本地盘只有 NFS 的几百分之一，写满会拖垮整台机器。宁可在开工前失败。
remote_script+="; free_mib=\$(df -Pm ${local_cache_root} | awk 'NR==2 {print \$4}')"
remote_script+="; [ \"\$free_mib\" -ge ${local_cache_min_free_mib} ] || {"
remote_script+=" printf 'remote-run: %s has %s MiB free, need %s MiB\\n'"
remote_script+=" ${local_cache_root} \"\$free_mib\" ${local_cache_min_free_mib} >&2; exit 1; }"
remote_script+="; export CARGO_HOME=${remote_root}/cargo-home"
remote_script+="; export CARGO_TARGET_DIR=${local_cache_root}/${cache_relative}"
remote_script+="; export TMPDIR=${local_cache_root}/tmp"
remote_script+="; export BW_AGENT_ROOT=${remote_root}"
remote_script+="; export BW_CORPUS_DIR=${remote_root}/corpus"
remote_script+="; export BW_RESULTS_DIR=${remote_root}/results"
remote_script+="; cd ${remote_worktree}"
remote_script+="; exec"
for argument in "$@"; do
  printf -v quoted_argument '%q' "$argument"
  remote_script+=" ${quoted_argument}"
done

# OpenSSH joins the remote command arguments with spaces. Quote the complete
# bash program once so command arguments remain separate after both shell hops.
single_quoted_script="${remote_script//\'/\'\\\'\'}"
remote_request="bash -c '${single_quoted_script}'"

printf 'remote-run: executing on %s (cache=%s at %s)\n' \
  "$remote_host" "$cache_name" "${local_cache_root}/${cache_relative}" >&2
ssh "${ssh_options[@]}" "$remote_host" "$remote_request"
