{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BoundaryWitness Blind Runner Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runner_version",
    "runner_commit",
    "run_id",
    "suite_id",
    "split",
    "method_commit",
    "archive_sha256",
    "deployment_json_sha256",
    "install_receipt_sha256",
    "public_manifest_sha256",
    "policy_sha256",
    "case_count",
    "isolation_backend",
    "case_execution_snapshot_digest",
    "observations_sha256",
    "stdout_stderr_digest",
    "witness_tree_sha256",
    "run_checksums_sha256",
    "created_at_utc",
    "host_id",
    "trust"
  ],
  "properties": {
    "schema_version": { "const": "boundary-witness.blind-runner-receipt/0.1" },
    "runner_version": { "type": "string", "minLength": 1 },
    "runner_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "run_id": { "type": "string", "minLength": 1 },
    "suite_id": { "type": "string", "minLength": 1 },
    "split": { "enum": ["gate", "evaluation"] },
    "method_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "archive_sha256": { "$ref": "#/$defs/sha256" },
    "deployment_json_sha256": { "$ref": "#/$defs/sha256" },
    "install_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "public_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "policy_sha256": { "$ref": "#/$defs/sha256" },
    "case_count": { "type": "integer", "minimum": 1 },
    "isolation_backend": {
      "enum": ["container", "cgroup-pid-namespace"]
    },
    "case_execution_snapshot_digest": { "$ref": "#/$defs/sha256" },
    "observations_sha256": { "$ref": "#/$defs/sha256" },
    "stdout_stderr_digest": { "$ref": "#/$defs/sha256" },
    "witness_tree_sha256": { "$ref": "#/$defs/sha256" },
    "run_checksums_sha256": { "$ref": "#/$defs/sha256" },
    "created_at_utc": { "type": "string", "minLength": 1 },
    "host_id": { "type": "string", "minLength": 1 },
    "trust": { "$ref": "#/$defs/trust" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "signature_sha256"],
      "properties": {
        "key_id": { "type": "string", "minLength": 1 },
        "signature_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
