{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boundary-witness.d1-summary/0.1",
  "type": "object",
  "required": [
    "schema_version",
    "total_campaigns",
    "primary_success_campaigns",
    "timeout_campaigns",
    "progress_campaigns",
    "secondary_campaigns",
    "total_executions",
    "valid_sequence_count",
    "invalid_sequence_count",
    "valid_sequence_ratio_ppm",
    "time_to_first_primary_ms",
    "campaigns"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "boundary-witness.d1-summary/0.1" },
    "total_campaigns": { "type": "integer", "minimum": 0 },
    "primary_success_campaigns": { "type": "integer", "minimum": 0 },
    "timeout_campaigns": { "type": "integer", "minimum": 0 },
    "progress_campaigns": { "type": "integer", "minimum": 0 },
    "secondary_campaigns": { "type": "integer", "minimum": 0 },
    "total_executions": { "type": "integer", "minimum": 0 },
    "valid_sequence_count": { "type": "integer", "minimum": 0 },
    "invalid_sequence_count": { "type": "integer", "minimum": 0 },
    "valid_sequence_ratio_ppm": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "time_to_first_primary_ms": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 }
    },
    "campaigns": { "type": "array" }
  }
}
