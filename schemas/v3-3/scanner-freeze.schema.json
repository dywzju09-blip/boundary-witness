{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boundary-witness.v3-3.scanner-freeze.1",
  "title": "BoundaryWitness V3.3 Scanner Freeze Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "frozen_at_utc",
    "method",
    "inputs",
    "toolchain",
    "source_identity_scan",
    "outputs",
    "notes"
  ],
  "properties": {
    "schema_version": { "const": "v3.3.scanner_freeze.1" },
    "run_id": { "type": "string", "minLength": 1 },
    "frozen_at_utc": { "type": "string", "minLength": 1 },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "branch", "worktree_required_clean"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "branch": { "type": "string", "minLength": 1 },
        "worktree_required_clean": { "const": true }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpus_manifest_sha256",
        "anonymous_pairs_sha256",
        "feature_profile_sha256",
        "source_checksums_sha256",
        "contract_toml_sha256",
        "api_map_sha256"
      ],
      "properties": {
        "corpus_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "anonymous_pairs_sha256": { "$ref": "#/$defs/sha256" },
        "feature_profile_sha256": { "$ref": "#/$defs/sha256" },
        "source_checksums_sha256": { "$ref": "#/$defs/sha256" },
        "contract_toml_sha256": { "$ref": "#/$defs/sha256" },
        "api_map_sha256": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cargo_build_locked_for_method",
        "scanner_build_precheck_locked",
        "static_facts_rustup_toolchain",
        "static_facts_dyld_library_path",
        "stable_rustc"
      ],
      "properties": {
        "cargo_build_locked_for_method": { "const": true },
        "scanner_build_precheck_locked": { "type": "boolean" },
        "static_facts_rustup_toolchain": { "type": "string", "minLength": 1 },
        "static_facts_dyld_library_path": { "type": "string", "minLength": 1 },
        "stable_rustc": { "type": "string", "minLength": 1 }
      }
    },
    "source_identity_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scanner_metadata_forbidden_tokens",
        "source_tree_strong_identity_tokens_zero",
        "generic_source_token_counts"
      ],
      "properties": {
        "scanner_metadata_forbidden_tokens": { "const": "pass" },
        "source_tree_strong_identity_tokens_zero": { "const": true },
        "generic_source_token_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buildability_sha256",
        "boundary_index_sha256",
        "static_facts_sha256",
        "mir_coverage_sha256",
        "candidates_sha256",
        "contracts_sha256",
        "lifecycle_evidence_sha256",
        "lifecycle_facts_sha256",
        "lifecycle_coverage_sha256",
        "lifecycle_features_sha256",
        "ranked_candidates_sha256"
      ],
      "properties": {
        "buildability_sha256": { "$ref": "#/$defs/sha256" },
        "boundary_index_sha256": { "$ref": "#/$defs/sha256" },
        "static_facts_sha256": { "$ref": "#/$defs/sha256" },
        "mir_coverage_sha256": { "$ref": "#/$defs/sha256" },
        "candidates_sha256": { "$ref": "#/$defs/sha256" },
        "contracts_sha256": { "$ref": "#/$defs/sha256" },
        "lifecycle_evidence_sha256": { "$ref": "#/$defs/sha256" },
        "lifecycle_facts_sha256": { "$ref": "#/$defs/sha256" },
        "lifecycle_coverage_sha256": { "$ref": "#/$defs/sha256" },
        "lifecycle_features_sha256": { "$ref": "#/$defs/sha256" },
        "ranked_candidates_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
