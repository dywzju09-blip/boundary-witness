{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boundary-witness.v3-2.boundary-index.1",
  "title": "BoundaryWitness V3.2 Boundary Index Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "crate_id",
    "boundary_id",
    "boundary_kind",
    "api_path",
    "evidence_refs",
    "confidence",
    "notes"
  ],
  "properties": {
    "schema_version": { "const": "v3.2.boundary_index.1" },
    "run_id": { "type": "string", "minLength": 1 },
    "crate_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9:._+-]+$",
      "not": {
        "pattern": "([Cc][Vv][Ee]-|[Gg][Hh][Ss][Aa]-|[Pp][Oo][Cc]|[Pp][Aa][Tt][Cc][Hh]|[Aa][Dd][Vv][Ii][Ss][Oo][Rr][Yy])"
      }
    },
    "boundary_id": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "([Cc][Vv][Ee]-|[Gg][Hh][Ss][Aa]-|[Pp][Oo][Cc]|[Pp][Aa][Tt][Cc][Hh]|[Aa][Dd][Vv][Ii][Ss][Oo][Rr][Yy])"
      }
    },
    "boundary_kind": {
      "enum": [
        "native_library",
        "callback_registration",
        "callback_unregistration",
        "foreign_retained_pointer",
        "opaque_handle_transfer",
        "returned_borrow",
        "external_buffer",
        "negative_summary"
      ]
    },
    "api_path": {
      "type": ["string", "null"],
      "not": {
        "pattern": "([Cc][Vv][Ee]-|[Gg][Hh][Ss][Aa]-|[Pp][Oo][Cc]|[Pp][Aa][Tt][Cc][Hh]|[Aa][Dd][Vv][Ii][Ss][Oo][Rr][Yy])"
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "line_start", "line_end"],
        "properties": {
          "kind": { "enum": ["source_span", "manifest", "build_log"] },
          "path": {
            "type": "string",
            "minLength": 1,
            "not": {
              "anyOf": [
                { "pattern": "^/" },
                { "pattern": "(^|/)\\.\\.(/|$)" },
                {
                  "pattern": "([Cc][Vv][Ee]-|[Gg][Hh][Ss][Aa]-|[Pp][Oo][Cc]|[Pp][Aa][Tt][Cc][Hh]|[Aa][Dd][Vv][Ii][Ss][Oo][Rr][Yy])"
                }
              ]
            }
          },
          "line_start": { "type": ["integer", "null"], "minimum": 1 },
          "line_end": { "type": ["integer", "null"], "minimum": 1 }
        },
        "allOf": [
          {
            "if": {
              "properties": { "kind": { "const": "source_span" } },
              "required": ["kind"]
            },
            "then": {
              "properties": {
                "line_start": { "type": "integer", "minimum": 1 },
                "line_end": { "type": "integer", "minimum": 1 }
              }
            }
          }
        ]
      }
    },
    "confidence": { "enum": ["high", "medium", "low"] },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "not": {
          "pattern": "([Cc][Vv][Ee]-|[Gg][Hh][Ss][Aa]-|[Pp][Oo][Cc]|[Pp][Aa][Tt][Cc][Hh]|[Aa][Dd][Vv][Ii][Ss][Oo][Rr][Yy])"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "boundary_kind": { "const": "negative_summary" } },
        "required": ["boundary_kind"]
      },
      "then": {
        "properties": { "api_path": { "type": "null" } }
      },
      "else": {
        "properties": { "api_path": { "type": "string", "minLength": 1 } }
      }
    }
  ]
}
