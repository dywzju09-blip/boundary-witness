{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boundary-witness.v3-2.buildability.1",
  "title": "BoundaryWitness V3.2 Buildability Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "crate_id",
    "status",
    "toolchain",
    "target",
    "native_dependencies",
    "elapsed_ms",
    "log_ref",
    "failure_class"
  ],
  "properties": {
    "schema_version": { "const": "v3.2.buildability.1" },
    "run_id": { "type": "string", "minLength": 1 },
    "crate_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9:._-]+$"
    },
    "status": {
      "enum": [
        "buildable",
        "not_buildable",
        "requires_system_dependency",
        "unsupported_target",
        "timeout",
        "tool_error"
      ]
    },
    "toolchain": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "minLength": 1 },
    "native_dependencies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "elapsed_ms": { "type": "integer", "minimum": 0 },
    "log_ref": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "(^|/)\\.\\.(/|$)" }
        ]
      }
    },
    "failure_class": {
      "type": ["string", "null"]
    },
    "original_status": {
      "enum": [
        "buildable",
        "not_buildable",
        "requires_system_dependency",
        "unsupported_target",
        "timeout",
        "tool_error"
      ]
    },
    "original_failure_class": {
      "type": "string",
      "minLength": 1
    },
    "fallback_status": {
      "enum": [
        "buildable",
        "not_buildable",
        "requires_system_dependency",
        "unsupported_target",
        "timeout",
        "tool_error"
      ]
    },
    "fallback_failure_class": {
      "type": "string",
      "minLength": 1
    },
    "fallback_rustflags": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "buildable" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "failure_class": { "type": "null" } }
      },
      "else": {
        "properties": { "failure_class": { "type": "string", "minLength": 1 } }
      }
    },
    {
      "if": {
        "required": ["fallback_status"]
      },
      "then": {
        "required": ["fallback_rustflags"]
      }
    },
    {
      "if": {
        "required": ["fallback_rustflags"]
      },
      "then": {
        "required": ["fallback_status"]
      }
    }
  ]
}
