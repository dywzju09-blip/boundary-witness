{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boundary-witness.v3-2.failure-taxonomy.1",
  "title": "BoundaryWitness V3.2 Failure Taxonomy Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "subject_kind",
    "subject_id",
    "crate_id",
    "stage",
    "failure_class",
    "is_infrastructure_failure",
    "is_method_negative",
    "notes"
  ],
  "properties": {
    "schema_version": { "const": "v3.2.failure_taxonomy.1" },
    "run_id": { "type": "string", "minLength": 1 },
    "subject_kind": { "enum": ["crate", "candidate"] },
    "subject_id": { "type": "string", "minLength": 1 },
    "crate_id": { "type": "string", "minLength": 1 },
    "stage": {
      "enum": [
        "build_precheck",
        "boundary_index",
        "candidate_partition",
        "lifecycle_ranking",
        "dynamic_prep"
      ]
    },
    "failure_class": {
      "enum": [
        "requires_system_dependency",
        "cargo_check_failed",
        "not_buildable",
        "unsupported_target",
        "timeout",
        "tool_error",
        "no_supported_boundary_pattern",
        "deferred_static_only",
        "analyzer_unsupported",
        "insufficient_evidence",
        "integrity_failure"
      ]
    },
    "is_infrastructure_failure": { "type": "boolean" },
    "is_method_negative": { "type": "boolean" },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
