{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boundary-witness.v3-2.corpus-manifest.1",
  "title": "BoundaryWitness V3.2 Corpus Manifest Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "crate_id",
    "crate_name",
    "version",
    "source_kind",
    "source_ref",
    "selection_reason",
    "intake_status",
    "intake_notes"
  ],
  "properties": {
    "schema_version": { "const": "v3.2.corpus_manifest.1" },
    "corpus_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^corpus\\.v3-2\\.[A-Za-z0-9._-]+$"
    },
    "crate_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9:._-]+$"
    },
    "crate_name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "version": { "type": "string", "minLength": 1 },
    "source_kind": {
      "enum": ["crates_io", "git_archive", "local_archive", "registry_snapshot"]
    },
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "([Cc][Vv][Ee]-|[Gg][Hh][Ss][Aa]-|[Pp][Oo][Cc]|[Pp][Aa][Tt][Cc][Hh]|[Aa][Dd][Vv][Ii][Ss][Oo][Rr][Yy])"
      }
    },
    "selection_reason": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "native_dependency",
          "callback_api_candidate",
          "ffi_dependency",
          "bindgen_usage",
          "links_metadata",
          "pure_rust",
          "iterator_api_candidate",
          "container_lifecycle_surface",
          "wrapper_api_candidate",
          "destructure_lifecycle_surface",
          "allocator_api_candidate",
          "iterator_lifetime_surface",
          "concurrent_cell_surface",
          "conversion_api_candidate",
          "slice_view_surface",
          "manual_exclusion_record"
        ]
      }
    },
    "intake_status": { "enum": ["accepted", "excluded"] },
    "intake_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "not": {
          "pattern": "([Cc][Vv][Ee]-|[Gg][Hh][Ss][Aa]-|[Pp][Oo][Cc]|[Pp][Aa][Tt][Cc][Hh]|[Aa][Dd][Vv][Ii][Ss][Oo][Rr][Yy])"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "intake_status": { "const": "excluded" } },
        "required": ["intake_status"]
      },
      "then": {
        "properties": { "intake_notes": { "minItems": 1 } }
      }
    }
  ]
}
