{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boundary-witness.v3-2.candidate.1",
  "title": "BoundaryWitness V3.2 Candidate Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "candidate_id",
    "crate_id",
    "boundary_id",
    "pattern_family",
    "confidence",
    "evidence_refs",
    "api_path",
    "recommended_next_step",
    "notes"
  ],
  "properties": {
    "schema_version": { "const": "v3.2.candidate.1" },
    "run_id": { "type": "string", "minLength": 1 },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "([Cc][Vv][Ee]-|[Gg][Hh][Ss][Aa]-|[Pp][Oo][Cc]|[Pp][Aa][Tt][Cc][Hh]|[Aa][Dd][Vv][Ii][Ss][Oo][Rr][Yy])"
      }
    },
    "crate_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9:._+-]+$",
      "not": {
        "pattern": "([Cc][Vv][Ee]-|[Gg][Hh][Ss][Aa]-|[Pp][Oo][Cc]|[Pp][Aa][Tt][Cc][Hh]|[Aa][Dd][Vv][Ii][Ss][Oo][Rr][Yy])"
      }
    },
    "boundary_id": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "([Cc][Vv][Ee]-|[Gg][Hh][Ss][Aa]-|[Pp][Oo][Cc]|[Pp][Aa][Tt][Cc][Hh]|[Aa][Dd][Vv][Ii][Ss][Oo][Rr][Yy])"
      }
    },
    "pattern_family": {
      "enum": [
        "retained_borrowed_callback",
        "callback_lifecycle_release",
        "foreign_retained_pointer",
        "opaque_handle_transfer",
        "native_library_boundary",
        "returned_borrow_view",
        "external_buffer_view"
      ]
    },
    "confidence": {
      "enum": [
        "needs_dynamic_validation",
        "static_only",
        "low_priority"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "line_start", "line_end"],
        "properties": {
          "kind": { "enum": ["source_span", "manifest", "build_log"] },
          "path": {
            "type": "string",
            "minLength": 1,
            "not": {
              "anyOf": [
                { "pattern": "^/" },
                { "pattern": "(^|/)\\.\\.(/|$)" },
                {
                  "pattern": "([Cc][Vv][Ee]-|[Gg][Hh][Ss][Aa]-|[Pp][Oo][Cc]|[Pp][Aa][Tt][Cc][Hh]|[Aa][Dd][Vv][Ii][Ss][Oo][Rr][Yy])"
                }
              ]
            }
          },
          "line_start": { "type": ["integer", "null"], "minimum": 1 },
          "line_end": { "type": ["integer", "null"], "minimum": 1 }
        },
        "allOf": [
          {
            "if": {
              "properties": { "kind": { "const": "source_span" } },
              "required": ["kind"]
            },
            "then": {
              "properties": {
                "line_start": { "type": "integer", "minimum": 1 },
                "line_end": { "type": "integer", "minimum": 1 }
              }
            }
          }
        ]
      }
    },
    "api_path": {
      "type": ["string", "null"],
      "not": {
        "pattern": "([Cc][Vv][Ee]-|[Gg][Hh][Ss][Aa]-|[Pp][Oo][Cc]|[Pp][Aa][Tt][Cc][Hh]|[Aa][Dd][Vv][Ii][Ss][Oo][Rr][Yy])"
      }
    },
    "recommended_next_step": {
      "enum": [
        "generate_lifecycle_subgraph",
        "manual_review",
        "defer"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "not": {
          "pattern": "([Cc][Vv][Ee]-|[Gg][Hh][Ss][Aa]-|[Pp][Oo][Cc]|[Pp][Aa][Tt][Cc][Hh]|[Aa][Dd][Vv][Ii][Ss][Oo][Rr][Yy])"
        }
      }
    }
  }
}
