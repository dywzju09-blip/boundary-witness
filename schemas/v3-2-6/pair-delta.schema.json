{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boundary-witness.v3-2-6.pair-delta.1",
  "title": "BoundaryWitness V3.2.6 Pair Delta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "pair_id",
    "left_crate_id",
    "right_crate_id",
    "left_top_features",
    "right_top_features",
    "semantic_delta",
    "distinguishability",
    "notes"
  ],
  "properties": {
    "schema_version": { "const": "v3.2.6.pair_delta.1" },
    "run_id": { "type": "string", "minLength": 1 },
    "pair_id": { "type": "string", "minLength": 1 },
    "left_crate_id": { "type": "string", "minLength": 1 },
    "right_crate_id": { "type": "string", "minLength": 1 },
    "left_top_features": {
      "type": "array",
      "items": { "type": "string" }
    },
    "right_top_features": {
      "type": "array",
      "items": { "type": "string" }
    },
    "semantic_delta": {
      "type": "array",
      "items": { "type": "string" }
    },
    "distinguishability": {
      "enum": [
        "separable_static",
        "indistinguishable_static_only",
        "insufficient_evidence",
        "unpaired"
      ]
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
