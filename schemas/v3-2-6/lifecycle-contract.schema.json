{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boundary-witness.v3-2-6.lifecycle-contract.1",
  "title": "BoundaryWitness V3.2.6 Lifecycle Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "contract_id",
    "component_id",
    "api_id",
    "retention",
    "replacement",
    "release",
    "owner_semantics",
    "scope",
    "source"
  ],
  "properties": {
    "schema_version": { "const": "v3.2.6.lifecycle_contract.1" },
    "run_id": { "type": "string", "minLength": 1 },
    "contract_id": { "type": "string", "minLength": 1 },
    "component_id": { "type": "string", "minLength": 1 },
    "api_id": { "type": "string", "minLength": 1 },
    "retention": {
      "enum": ["may_retain_callback", "does_not_retain_callback", "unknown"]
    },
    "replacement": {
      "enum": [
        "replaces_prior_registration",
        "does_not_replace_prior_registration",
        "unknown"
      ]
    },
    "release": {
      "enum": [
        "covers_callback_and_user_data",
        "callback_only",
        "user_data_only",
        "unknown"
      ]
    },
    "owner_semantics": {
      "enum": ["foreign_owned", "rust_owned", "shared", "unknown"]
    },
    "scope": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
